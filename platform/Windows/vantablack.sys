#![no_std]
#![macro_use]

use wdk_sys::{DRIVER_OBJECT, UNICODE_STRING, NTSTATUS, STATUS_SUCCESS};

// Point d'entrée du driver (l'équivalent du init sous Linux)
#[no_mangle]
pub unsafe extern "system" fn DriverEntry(
    driver_object: *mut DRIVER_OBJECT,
    _registry_path: *mut UNICODE_STRING,
) -> NTSTATUS {
    
    // Configurer la fonction de déchargement
    ((*driver_object).DriverUnload = Some(driver_unload));

    // Ton fameux log (visible dans DbgView ou un debugger comme WinDbg)
    // On utilise la macro native du kernel Windows via les bindings
    wdk_sys::DbgPrint(b"Vantablack: Hello from Windows Kernel Space!\n\0".as_ptr() as *const _);

    // Tu peux direct remettre tes fonctions CPUID ici !
    if check_vmx_support() {
        wdk_sys::DbgPrint(b"Vantablack: Intel VT-x supported on Windows host.\n\0".as_ptr() as *const _);
    }

    STATUS_SUCCESS
}

// Fonction de déchargement (l'équivalent du rmmod / drop)
pub unsafe extern "system" fn driver_unload(_driver_object: *mut DRIVER_OBJECT) {
    wdk_sys::DbgPrint(b"Vantablack: Driver unloaded. Leaving Ring 0.\n\0".as_ptr() as *const _);
}

unsafe fn check_vmx_support() -> bool {
    let ecx: u32;
    core::arch::asm!(
        "cpuid",
        inout("eax") 1 => _,
        out("ebx") _,
        out("ecx") ecx,
        out("edx") _,
    );
    (ecx & (1 << 5)) != 0
}
